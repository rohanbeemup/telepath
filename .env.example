# telegram-claude-sessions config — copy to .env and fill in the first three.
#   cp .env.example .env && chmod 600 .env
# .env is gitignored; it holds a bot token, so keep it 600.

# From @BotFather — create a NEW bot (/newbot) and paste its token here.
TELEGRAM_BOT_TOKEN=

# Your Telegram numeric user id (ONLY this id may talk to the bot / approve tools).
# REQUIRED — the daemon exits without it, so it can't print it for you. Get it
# from @userinfobot, or from getUpdates (see below / README step 3).
ALLOWED_USER_ID=

# The forum supergroup's chat id (negative, e.g. -1001234567890).
# Create a group → Settings → enable "Topics" → add the bot as admin with the
# "Manage Topics" permission → send /start there, then, with the daemon stopped:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" |
#     jq '.result[-1].message | {ALLOWED_USER_ID: .from.id, FORUM_CHAT_ID: .chat.id}'
# On Windows: .\get-ids.ps1
FORUM_CHAT_ID=

# ── Optional (defaults shown) ──
# Default working directory for /new when no cwd= is given (defaults to $HOME).
#DEFAULT_CWD=/home/you/code
# Models: four packages (keys haiku/sonnet/opus/fable), each mapped to an id
# here. DEFAULT_MODEL is used for new topics; "use fable high" / "use opus" /
# "use sonnet" switch one topic at runtime (the menus do the same with buttons).
# Rough cost per MTok in/out: Fable 5.1 $10/$50 > Opus 5 $5/$25 > Sonnet 5 $2/$10
# > Haiku 4.5 $1/$5. Pin an older generation here if you prefer it
# (e.g. OPUS_MODEL=claude-opus-4-8, SONNET_MODEL=claude-sonnet-4-6).
DEFAULT_MODEL=claude-sonnet-5
HAIKU_MODEL=claude-haiku-4-5
SONNET_MODEL=claude-sonnet-5
OPUS_MODEL=claude-opus-5
FABLE_MODEL=claude-fable-5-1
# Which models the menus offer — only list ones your auth can actually use; a
# model your plan lacks fails on the first message of a topic. Fable is premium
# and not on every plan, so it's off by default: ENABLED_MODELS=haiku,sonnet,opus,fable
ENABLED_MODELS=sonnet,opus
# Effort (reasoning depth) for new topics: low | medium | high | xhigh | max.
# Leave unset to let Claude Code decide. Per topic it's a button on the pinned
# panel or "effort max" / "effort default" typed in the topic. Haiku has no levels.
#DEFAULT_EFFORT=high
# Root the folder picker scans for projects (defaults to the parent of DEFAULT_CWD).
#REPOS_DIR=/home/you/code
# Close a session after this many idle minutes (it resumes transparently next message).
IDLE_MINUTES=15
# Max concurrently-live sessions (least-recently-used is evicted beyond this).
MAX_LIVE_SESSIONS=3
# Override where .env/registry.json/prefs.json/outbox live (defaults to the repo directory).
#TG_CLAUDE_STATE_DIR=/home/you/.config/telegram-claude-sessions
# Force a specific claude binary (defaults to the SDK's bundled one, then PATH).
#CLAUDE_BINARY=/home/you/.local/bin/claude
