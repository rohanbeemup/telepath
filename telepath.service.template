[Unit]
Description=telepath (Telegram forum topic ⇄ resident Claude session)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=__REPO_DIR__
# bun runs the daemon directly. PATH must include bun and the claude CLI.
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=__BUN__ run __REPO_DIR__/daemon.ts
Restart=always
RestartSec=10
TimeoutStopSec=20
Nice=5

[Install]
WantedBy=default.target
